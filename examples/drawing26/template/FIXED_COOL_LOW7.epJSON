  "EnergyManagementSystem:Program": {
    "R1278_controller": {
      "lines": [
        {
          "program_line": "SET R1278_ref = R1278_T"
        },
        {
          "program_line": "SET R1278_previous = R1278_state"
        },
        {
          "program_line": "IF R1278_available <= 0"
        },
        {
          "program_line": " SET R1278_state = 0"
        },
        {
          "program_line": "ELSEIF (R1278_state == 1) && (R1278_T < (R1278_heat - 0.01))"
        },
        {
          "program_line": " SET R1278_state = 1"
        },
        {
          "program_line": "ELSEIF (R1278_state == 2) && (R1278_T > (R1278_cool + 0.01))"
        },
        {
          "program_line": " SET R1278_state = 2"
        },
        {
          "program_line": "ELSEIF R1278_T < R1278_low"
        },
        {
          "program_line": " SET R1278_state = 1"
        },
        {
          "program_line": "ELSEIF R1278_T > R1278_high"
        },
        {
          "program_line": " SET R1278_state = 2"
        },
        {
          "program_line": "ELSE"
        },
        {
          "program_line": " SET R1278_state = 0"
        },
        {
          "program_line": "ENDIF"
        },
        {
          "program_line": "SET R1278_control_act = R1278_state"
        },
        {
          "program_line": "SET R1278_enable_act = 0"
        },
        {
          "program_line": "IF R1278_state > 0"
        },
        {
          "program_line": " SET R1278_enable_act = 1"
        },
        {
          "program_line": "ENDIF"
        }
      ]
    },
